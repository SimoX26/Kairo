{
  "name": "kairo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Timer, Pomodoro, calendario e insight local-first per Android.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite --host 0.0.0.0",
